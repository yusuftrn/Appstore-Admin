include README.md LICENSE SECURITY.md CONTRIBUTING.md CHANGELOG.md THIRD_PARTY_NOTICES.md pyproject.toml
include .gitignore .gitattributes
include bin/appstore-admin
recursive-include src/appstore_admin *.py *.json
recursive-include skills/appstore-admin *.md *.yaml *.py
recursive-include tests *.py
recursive-include tools *.py
recursive-include docs *.md
recursive-include examples *.example.json
prune .local
prune .venv
prune build
prune dist
global-exclude *.p8 *.pem *.key *.pyc .DS_Store
global-exclude __pycache__
